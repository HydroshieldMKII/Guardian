{
  "name": "backend",
  "version": "2.2.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\" --no-fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:generate": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:generate -d src/database/cli.data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-proxy": "^1.18.1",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/linkify-it": "^5.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/mdurl": "^2.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.9",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "tar": "^7.5.3"
  }
}
